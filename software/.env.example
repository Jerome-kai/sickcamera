OPENAI_API_KEY=replace-with-your-api-key-or-vercel-gateway-key
# Leave empty for api.openai.com; set to your gateway for proxied billing,
# e.g. https://ai-gateway.vercel.sh/v1 for the Vercel AI Gateway.
OPENAI_BASE_URL=
IMAGE_GEN_HOST=0.0.0.0
IMAGE_GEN_PORT=8000
# edits       = /v1/images/edits (direct api.openai.com with gpt-image-2)
# chat        = /v1/chat/completions with a multimodal image model — required for
#               gateways that don't expose /v1/images/edits (e.g. Vercel AI Gateway)
# generations = /v1/images/generations with an `image` field — the image-edit path
#               on Chinese OpenAI-compatible providers (SiliconFlow, Volcano Ark)
IMAGE_GEN_API=edits
# With a gateway, model names need a provider prefix. Vercel gateway recipe:
#   IMAGE_GEN_API=chat + IMAGE_GEN_MODEL=google/gemini-2.5-flash-image
# China (no VPN) recipe — SiliconFlow (siliconflow.cn):
#   OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#   IMAGE_GEN_API=generations + IMAGE_GEN_MODEL=Qwen/Qwen-Image-Edit-2509
#   MAGIC_MODE_API=chat + MAGIC_MODE_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
IMAGE_GEN_MODEL=gpt-image-2
IMAGE_GEN_QUALITY=low
IMAGE_GEN_SIZE=1536x1024
IMAGE_GEN_OUTPUT_FORMAT=jpeg
IMAGE_GEN_OUTPUT_COMPRESSION=85
IMAGE_GEN_TIMEOUT_SECONDS=90
IMAGE_GEN_INPUT_WIDTH=1280
IMAGE_GEN_INPUT_HEIGHT=960
# How many times a queued generation is retried before the camera gives up.
# Retrying forever suits "the Wi-Fi is down" but not a prompt the model always
# refuses. Abandoned jobs are kept in data/queue/failed/ for inspection; the
# capture itself is never deleted. Set to 0 to retry forever.
QUEUE_MAX_ATTEMPTS=12
MAGIC_MODE_ENABLED=1
# responses = /v1/responses (api.openai.com and gateways that proxy it)
# chat      = /v1/chat/completions — for providers without a responses endpoint
#             (Chinese OpenAI-compatible APIs)
MAGIC_MODE_API=responses
# With a gateway, prefix this too, e.g. openai/gpt-4.1-mini
MAGIC_MODE_MODEL=gpt-4.1-mini
MAGIC_MODE_TIMEOUT_SECONDS=30

# Hardware target: opi = Orange Pi Zero 2 (this fork's default), pi = original Raspberry Pi stack
IMAGEGENCAM_HW=opi

# USB camera (V4L2 index: /dev/video0 -> 0)
CAMERA_DEVICE=0
CAMERA_PREVIEW_WIDTH=480
CAMERA_PREVIEW_HEIGHT=360
# Capture rate. The display cannot exceed the SPI ceiling below, so there is no
# point pushing this far past PREVIEW_TARGET_FPS. Check what your camera
# actually offers: v4l2-ctl -d /dev/video0 --list-formats-ext
CAMERA_FRAME_RATE=15
CAMERA_ROTATION_DEGREES=0
CAMERA_SWAP_RED_BLUE=1
CAMERA_STALE_FRAME_TIMEOUT_SECONDS=2.0

# GPIO backend: auto = try gpiod (kernel 5.10+), fall back to sysfs (legacy 4.9 kernel).
# sysfs pull-ups are set via /dev/mem (root) — see HARDWARE.md "Legacy kernel" section.
GPIO_BACKEND=auto
GPIO_SYSFS_BASE=0
SUNXI_SET_PULLUPS=1
# Exporting a sysfs GPIO creates its files, but udev is what makes them
# readable by the gpio group a moment later. At boot udev is busy, so the app
# retries for this long instead of failing to start.
GPIO_SYSFS_READY_TIMEOUT_SECONDS=5

# SPI display (Orange Pi Zero 2 wiring — see HARDWARE.md)
# st7796  = 3.5"/3.2" 480x320 ST7796S/U modules (e.g. lcdwiki MSP3526,
#           "3.5 TFT SPI 480X320 V1.0" capacitive touch; touch/FPC unused).
# ili9341 = 2.8" 240x320 modules — 320x240 landscape, pixel-perfect UI match.
DISPLAY_CONTROLLER=st7796
GPIO_CHIP=/dev/gpiochip0
DISPLAY_SPI_BUS=1
# Legacy 4.9 kernel image exposes /dev/spidev1.1 -> DEV=1; modern images expose
# /dev/spidev1.0 -> DEV=0. Check with: ls /dev/spidev*
DISPLAY_SPI_DEV=1
# The preview's real ceiling. A full 480x320 RGB565 frame is 307200 bytes, so
# 40MHz = ~61ms/frame = ~16fps maximum no matter how idle the CPU is.
# 50000000 -> ~20fps, 62500000 -> ~25fps. Most ST7796 modules take 50MHz
# happily; if you see torn or speckled frames, step back down.
DISPLAY_SPI_HZ=40000000
DISPLAY_DC_PIN=74
DISPLAY_RST_PIN=71
DISPLAY_BACKLIGHT_PIN=79
DISPLAY_INVERT=0
DISPLAY_ROTATION_180=0
# pillarbox = keep 4:3 UI centered with black side bars; stretch = fill 480x320
DISPLAY_FIT=pillarbox

# Redraw budgets, in frames per second. The preview is the one that matters;
# menus and the album are static between key presses. Leave empty for the
# defaults (preview 15, menu 10, album 10). The diagnostics screen shows the
# rates actually achieved -- triple-press up, then the top-right tab.
PREVIEW_TARGET_FPS=15
MENU_TARGET_FPS=10
ALBUM_TARGET_FPS=10

# Which side of the screen the button cluster sits on: the on-screen hint tabs
# render next to the physical buttons. This build's chassis puts them right.
UI_CONTROLS_SIDE=right

# Buttons (gpiod line numbers; PCn = 64+n, PHn = 224+n)
BUTTON_SHUTTER_PIN=73
BUTTON_UI_DOWN_PIN=70
BUTTON_UI_UP_PIN=69
BUTTON_UI_ALBUM_PIN=72
BUTTON_UI_PROMPT_PIN=78

# Hot shoe flash trigger via MOC3021 opto-triac (see HARDWARE.md "Hot shoe").
# GPIO --330R--> MOC3021 pin 1, pin 2 -> GND; pin 6 -> shoe center contact,
# pin 4 -> shoe metal frame. Fires on every capture when enabled.
HOTSHOE_ENABLED=0
# PC11 = header pin 12, gpiod line 75
HOTSHOE_PIN=75
# How long the trigger stays asserted. A xenon flash latches the triac and
# fires instantly; LED lights that only shine while triggered stay on long
# enough to cover the captured frame.
HOTSHOE_PULSE_MS=200

# How long to wait for the USB camera at startup. The service can start before
# the device finishes enumerating, so it retries for this long before failing.
CAMERA_OPEN_TIMEOUT_SECONDS=30

# Wi-Fi (NetworkManager interface name)
WIFI_INTERFACE=wlan0

# Screen sleep after this many seconds without a button press (0 disables).
# The backlight turns off and the camera idles; any button wakes it instantly.
SLEEP_AFTER_SECONDS=300

# First-run setup hotspot. When the camera boots and finds no known network it
# publishes its own Wi-Fi, shows the join details on the display, and serves the
# network picker in the web UI -- so a new owner never needs a terminal.
# Set WIFI_SETUP_PORTAL=0 to disable it entirely.
WIFI_SETUP_PORTAL=1
# Seconds to let NetworkManager try saved networks before giving up.
WIFI_SETUP_GRACE_SECONDS=45
# A hotspot cannot scan or auto-join, so the camera drops it this often to check
# whether a known network came back (a router switched on late, a hotspot
# re-enabled). Deferred while somebody has the setup page open.
WIFI_SETUP_RETRY_SECONDS=600
# How long to wait for NetworkManager to rejoin before republishing the hotspot.
WIFI_SETUP_REJOIN_SECONDS=40
# How often to re-check that a camera which IS online still is. The hotspot is
# republished whenever the network goes away for good -- not just at boot --
# so a router swap or a changed password can never leave the camera
# unreachable with no way back in.
WIFI_SETUP_OFFLINE_POLL_SECONDS=60
# Hotspot name. Defaults to ImageGenCam-<last 4 chars of hostname>.
# WIFI_SETUP_AP_SSID=ImageGenCam-Setup
# Hotspot password. By default each camera generates its own random password on
# first use (kept in data/ap_password, shown on the display next to the SSID),
# so nothing printed in this repository gets a stranger onto your camera.
# Uncomment to pin a fixed password instead; WPA2 requires at least 8 chars.
# WIFI_SETUP_AP_PASSWORD=

# PiSugar battery pack (not used on the Orange Pi build)
PISUGAR_ENABLED=0
PISUGAR_POWER_BUTTON_SHUTTER=0
