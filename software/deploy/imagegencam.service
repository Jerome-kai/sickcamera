[Unit]
Description=ImageGenCam
After=imagegencam-boot-splash.service
Wants=imagegencam-boot-splash.service
# The camera is a USB device that appears a few seconds into boot, so early
# starts can legitimately fail. A short burst window would exhaust the retries
# within that gap and disable the unit until someone starts it by hand; this
# window is long enough to ride out enumeration and a flaky contact, while a
# genuinely dead camera still stops the retry loop.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__PROJECT_ROOT__
Environment=PYTHONPATH=__PROJECT_ROOT__/src
EnvironmentFile=-__PROJECT_ROOT__/.env
Environment=IMAGE_GEN_PORT=80
Environment=IMAGE_GEN_SERVICE_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
SupplementaryGroups=gpio spi video
ExecStart=__PROJECT_ROOT__/scripts/run.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
