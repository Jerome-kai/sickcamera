__SERVICE_USER__ ALL=(root) NOPASSWD: /usr/bin/nmcli connection up id *, /usr/bin/nmcli connection down id imagegencam-setup, /usr/bin/nmcli device wifi connect *, /usr/bin/nmcli device wifi hotspot ifname __WIFI_INTERFACE__ con-name imagegencam-setup ssid * password *, /usr/bin/nmcli dev wifi rescan ifname __WIFI_INTERFACE__, /usr/bin/nmcli -t -f active\,ssid\,signal\,security dev wifi list ifname __WIFI_INTERFACE__ --rescan no, /usr/bin/nmcli -t -f NAME\,TYPE connection show --active, /usr/bin/nmcli -t -f IP4.ADDRESS device show __WIFI_INTERFACE__
