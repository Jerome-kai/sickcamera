.DS_Store
.env*
software/.env*
!software/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
software/.venv/
**/__pycache__/
**/*.pyc
software/.pytest_cache/
software/data/captures/*
!software/data/captures/.gitkeep
software/data/generated/*
!software/data/generated/.gitkeep
software/data/queue/*
!software/data/queue/.gitkeep
software/data/thumbnails/
software/data/ap_password
# Seeded per-device from .env on first run; committing one would silently
# override the model each camera is actually configured for.
software/data/models.json

# Android app
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/core/.gradle/
android/core/.kotlin/
android/core/build/
android/local.properties
android/*.apk
*.keystore
# Deliberately public: the fallback signing key, so unconfigured builds still update in place.
!android/signing/public-fallback.keystore
*.jks
